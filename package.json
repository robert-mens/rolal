{
  "name": "bet_app",
  "version": "1.0.0",
  "description": "Global Betting Sportsbook Platform - Out-of-Ghana Leagues",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev:server": "nodemon server/server.js",
